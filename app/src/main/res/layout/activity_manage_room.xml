<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:onClick="insert"
    tools:context=".ManageRoom">

    <EditText
        android:id="@+id/txtRoomID"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:ems="10"
        android:fontFamily="@font/nunito_regular"
        android:hint="Enter Room ID"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txtRoomName"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:ems="10"
        android:fontFamily="@font/nunito_regular"
        android:hint="Enter Room Name"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRoomID" />

    <EditText
        android:id="@+id/txtRoomCap"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:ems="10"
        android:fontFamily="@font/nunito_regular"
        android:hint="Enter Room Capacity"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRoomName" />

    <EditText
        android:id="@+id/txtRoomDes"
        android:layout_width="380dp"
        android:layout_height="60dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:ems="10"
        android:fontFamily="@font/nunito_italic"
        android:gravity="start|top"
        android:hint="Enter Room Description"
        android:inputType="textMultiLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRoomCap" />

    <EditText
        android:id="@+id/txtRoomPrice"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:ems="10"
        android:fontFamily="@font/nunito_regular"
        android:hint="Enter Room Price"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRoomDes" />

    <ImageView
        android:id="@+id/imageRoom"
        android:layout_width="380dp"
        android:layout_height="200dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtRoomPrice"
        tools:srcCompat="@tools:sample/avatars" />

    <Button
        android:id="@+id/btnRoomImage"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:backgroundTint="#1B113A"
        android:fontFamily="@font/nunito_black"
        android:onClick="selectImage"
        android:text="Select Image"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/btnAddRoom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageRoom"
        app:layout_constraintVertical_bias="0.5" />

    <Button
        android:id="@+id/btnAddRoom"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        android:backgroundTint="#CE395D"
        android:fontFamily="@font/nunito_black"
        android:onClick="insert"
        android:text="Add Room"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:icon="@drawable/add_room"
        app:iconGravity="textStart"
        app:iconPadding="18dp"
        app:iconSize="25dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRoomImage" />

    <Button
        android:id="@+id/btnViewRoom"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:backgroundTint="#F49A34"
        android:fontFamily="@font/nunito_black"
        android:onClick="OpenViewAllRooms"
        android:text="View Rooms"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:icon="@drawable/view_room"
        app:iconGravity="textStart"
        app:iconSize="25dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAddRoom" />

</androidx.constraintlayout.widget.ConstraintLayout>