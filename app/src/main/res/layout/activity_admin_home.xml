<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdminHome">

    <Button
        android:id="@+id/btnLogoutAdmin"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginTop="29dp"
        android:fontFamily="@font/nunito_black"
        android:onClick="LogoutAdmin"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:icon="@drawable/logoutbutton"
        app:iconGravity="textStart"
        app:iconSize="35dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnViewServiceBookings" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="378dp"
        android:layout_height="55dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="17dp"
        android:background="#1B113A"
        android:backgroundTint="#1B113A"
        android:fontFamily="@font/lexend_bold"
        android:gravity="center"
        android:text="Welcome Admin!"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnManageUsers"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="#F49A34"
        android:fontFamily="@font/nunito_black"
        android:onClick="manageUsers"
        android:text="Manage Users"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:icon="@drawable/manage_users"
        app:iconGravity="textStart"
        app:iconSize="28dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="235dp"
        android:layout_height="219dp"
        android:layout_marginStart="79dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4"
        app:srcCompat="@drawable/lv" />

    <Button
        android:id="@+id/btnManageRooms"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="#CE395D"
        android:fontFamily="@font/nunito_black"
        android:onClick="manageRooms"
        android:text="Manage Rooms"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:icon="@drawable/room_preferences"
        app:iconGravity="textStart"
        app:iconSize="28dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnManageUsers" />

    <Button
        android:id="@+id/btnManageService"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="#FF5722"
        android:fontFamily="@font/nunito_black"
        android:onClick="manageServices"
        android:text="Manage Services"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:icon="@drawable/manage_service"
        app:iconGravity="textStart"
        app:iconPadding="18dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnManageRooms" />

    <Button
        android:id="@+id/btnViewRoomBook"
        android:layout_width="380dp"
        android:layout_height="49dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="#9C27B0"
        android:fontFamily="@font/nunito_black"
        android:onClick="viewRoomBook"
        android:text="View Room Bookings"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:icon="@drawable/view_book"
        app:iconGravity="textStart"
        app:iconSize="25dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnManageService" />

    <Button
        android:id="@+id/btnViewServiceBookings"
        android:layout_width="380dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="#2196F3"
        android:fontFamily="@font/nunito_black"
        android:onClick="viewServiceBook"
        android:text="View Service Bookings"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:icon="@drawable/viewallservicebook"
        app:iconGravity="textStart"
        app:iconPadding="20dp"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnViewRoomBook" />
</androidx.constraintlayout.widget.ConstraintLayout>