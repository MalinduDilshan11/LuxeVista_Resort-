<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Room ID -->
    <TextView
        android:id="@+id/textViewRoomId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#BDBDBD"
        android:backgroundTint="#BDBDBD"
        android:fontFamily="@font/nunito_black"
        android:gravity="center"
        android:text="Room ID"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textViewRoomName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/nunito_black"
        android:text="Room Name"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/textViewRoomCapacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_regular"
        android:text="Capacity:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textViewRoomDes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_italic"
        android:text="Description"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textViewRoomPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_regular"
        android:text="Price:"
        android:textColor="#FF0000"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/imageViewRoom"
        android:layout_width="380dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="5dp"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/btnAddToCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF9800"
        android:fontFamily="@font/nunito_black"
        android:text="Book Room"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:icon="@drawable/booking"
        app:iconGravity="textStart"
        app:iconSize="20dp"
        app:iconTint="@color/white" />
</LinearLayout>
